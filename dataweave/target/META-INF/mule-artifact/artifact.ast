i\",\n \t\tid:456,\n \t\tMaths :70,\n \t\tphysics:89 \t\t\n \t},\n \t{\n \t\tname :\"Ravi\",\n \t\tid:789,\n \t\tMaths:20,\n \t\tphysics:30\n \t\t\n \t}\n ]\n fun checkResult(marks)\u003dif(marks\u003e50)\"PASS\" else \"FAIL\"\n ---\n a map{\n \t\"name\" :$.name,\n    \"id\":$.id,\n \t\"subjectWiseDetails\":{\n \t\tMaths:{marks:$.Maths, status:checkResult($.Maths)},\n \t\tphysics:{marks:$.physics, status:checkResult($.physics)}\n \t}\n }\r\n]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cee:transform doc:name\u003d\"callingDWL\" doc:id\u003d\"55180369-ab80-480c-adf4-cff1c65050ac\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[\r\n%dw 2.0\nimport modules::MyFirstExternal\noutput application/json\n---\nMyFirstExternal::convertCase(\"Hello World\")\r\n]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cflow-ref doc:name\u003d\"Flow Reference\" doc:id\u003d\"48971d23-0205-4d44-9147-513010844993\" name\u003d\"dataweaveFlow2\"\u003e\u003c/flow-ref\u003e\r\n\u003c/flow\u003e","startColumn":2,"startLine":12},"parameters":[{"unresolvedValue":"dataweaveFlow","metadata":{"docAttributes":{"id":"e4a9034f-75c6-47c3-8bd7-ca45b1113e0b"},"endColumn":9,"endLine":331,"fileName":"dataweave.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":9},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":12},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":12},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":331},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":76},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":331}},"sourceCode":"\u003cflow name\u003d\"dataweaveFlow\" doc:id\u003d\"e4a9034f-75c6-47c3-8bd7-ca45b1113e0b\"\u003